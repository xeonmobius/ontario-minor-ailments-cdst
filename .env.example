# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role — SERVER ONLY, never NEXT_PUBLIC_. The Polar webhook
# sync is the only caller (src/lib/supabase/admin.ts); the DB trigger on
# pharmacies.subscription_tier rejects any other role.
SUPABASE_SERVICE_ROLE_KEY=

# Polar billing (docs/superpowers/specs/2026-11-03-polar-billing-design.md)
# Sandbox org access token (Polar dashboard → Settings → API keys)
POLAR_ACCESS_TOKEN=
# Webhook endpoint signing secret (whsec_...)
POLAR_WEBHOOK_SECRET=
# Pro monthly product ID (CAD $25/mo flat)
POLAR_PRODUCT_PRO_ID=
# true = Polar sandbox. Flip to false for production.
POLAR_SANDBOX=true

# App origin used for checkout success redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PHI persistence (fly.io host was dropped — dormant unless a new host is
# wired up; see AGENTS.md)
PHI_PERSIST_ENABLED=
